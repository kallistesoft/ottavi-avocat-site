# Apache settings for ottavilawfirm.com on the GoDaddy hosting.
DirectoryIndex index.html

# The deploy's state file must not be public.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# http:// and the bare domain → https://www.ottavilawfirm.com
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^ottavilawfirm\.com$ [NC]
RewriteRule ^ https://www.ottavilawfirm.com%{REQUEST_URI} [R=301,L]

# Browser cache. CSS and JS links carry a ?v= hash, so they can stay cached for a long time.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
